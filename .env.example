# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
# .env.local is ignored by Git. Never commit real keys.

# Qiyam API base URL (no trailing slash).
# Live server:  https://qiyamapi.14labs.co
# Local server: http://<your-laptop-wifi-ip>:<port>
#   (Do not use "localhost": on a phone, localhost means the phone itself.)
EXPO_PUBLIC_API_URL=https://qiyamapi.14labs.co

# Google Maps API key, used for maps on Android. Ask the team lead for it.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
